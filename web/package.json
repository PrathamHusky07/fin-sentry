{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "build:archive": "NEXT_PUBLIC_ARCHIVE_MODE=true NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:9 NEXT_DIST_DIR=.next-archive next build",
    "start:archive": "NEXT_PUBLIC_ARCHIVE_MODE=true NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:9 NEXT_DIST_DIR=.next-archive next start -p 3100",
    "test:e2e:archive": "playwright test --project=archive"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
