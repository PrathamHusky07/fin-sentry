# Every key the project reads, with no values. Copy to .env and fill in what you use.
# A hint after "default:" is what the code assumes when the key is unset or what local
# development uses. Nothing here is a secret, and a real .env is never committed.

# Dashboard/metrics service base URL. The gateway's SSE route (Day 8) polls
# this internally for a MetricsSnapshot -- the gateway itself never talks to
# RisingWave directly. http://localhost:8081 for local dev (the dashboard's
# documented port); http://dashboard:8081 inside the Day 8 Docker Compose
# network.
METRICS_SERVICE_URL=

# Downstream LLM or RAG endpoint the gateway proxies to. Local development: Ollama on
# http://localhost:11434.
DOWNSTREAM_URL=

# Downstream RAG model routing (Ollama tag or vLLM model name; not a Gemini model)
DOWNSTREAM_MODEL=

# Postgres URL for the dev database (used by ingestion scripts and the gateway at runtime).
DATABASE_URL=

# Postgres URL for the test database (used by pytest only). This database is truncated
# and reingested during test runs. Create it with: createdb finsentry_test
TEST_DATABASE_URL=

# SEC EDGAR identity header — required, EDGAR rejects requests without it
# Format: "AppName email@example.com"
EDGAR_IDENTITY=

# Hugging Face token, for downloading the gated local judge models.
HF_TOKEN=

# Set to 1 to load Hugging Face models from the local cache only.
HF_HUB_OFFLINE=

# Gemini Faithfulness rail: choose backend
GEMINI_MODE=

# Vertex AI mode (recommended, uses Google Cloud ADC auth + $300 credit)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Developer API mode (fallback, requires AI Studio API key)
# GEMINI_API_KEY=

GEMINI_MODEL=

# Kafka event emission for async evaluation pipeline
# Note: Redpanda uses dual listeners. Host-side processes (gateway, consumer,
# dashboard) connect via the EXTERNAL listener at localhost:19092.
# In-Docker services (RisingWave sources) use the INTERNAL listener at
# redpanda:9092 (configured in infra/risingwave/init.sql).
KAFKA_MODE=
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CONSUMER_GROUP=

# Topic and consumer-group overrides. Leave empty to use the project defaults
# (rag-responses, judge-verdicts, rag-frontier-verdicts).
KAFKA_TOPIC=
KAFKA_VERDICT_TOPIC=
KAFKA_FRONTIER_VERDICT_TOPIC=
FRONTIER_CONSUMER_GROUP=

# Frontier consumer tuning. default: the thresholds in finsentry/consumer/frontier_consumer.py,
# HHEM off, peer retrieval on.
FRONTIER_LAG_ENTRY_THRESHOLD=
FRONTIER_LAG_RECOVERY_THRESHOLD=
FRONTIER_HHEM_ENABLED=
FAITHJUDGE_PEER_RETRIEVAL_ENABLED=

# RisingWave connection used by the dashboard. default: localhost, 4566, root, dev.
RISINGWAVE_HOST=
RISINGWAVE_PORT=
RISINGWAVE_USER=
RISINGWAVE_DB=

# Names one gateway replica in responses and logs. default: a random suffix.
GATEWAY_INSTANCE_ID=

# OpenTelemetry exporter (none = spans created but not exported)
OTEL_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local-debugging only: logs a raw downstream-model-output snippet on a
# schema-rail block. Leave unset (OFF) in the demo configuration -- a
# reliability/compliance platform must not log raw model output by default.
# DEV_DIAGNOSTIC_LOGS=1

# Run password. Server-side only, never a NEXT_PUBLIC_ variable. It guards the two routes
# that start work: Red Team runs and investigations. The gateway refuses both when this is
# empty or unset. Reads need no password. Choose your own value.
RED_TEAM_RUN_PASSWORD=

# Frontend (web/). Set it in the Vercel project settings, not here. This is the one
# NEXT_PUBLIC_ variable and it is public by design: the base URL of the gateway the
# deployed site reads from, with no trailing slash. Unset, the site assumes
# http://localhost:8000.
NEXT_PUBLIC_GATEWAY_URL=
