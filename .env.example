# Dashboard/metrics service base URL. The gateway's SSE route (Day 8) polls
# this internally for a MetricsSnapshot -- the gateway itself never talks to
# RisingWave directly. http://localhost:8081 for local dev (the dashboard's
# documented port); http://dashboard:8081 inside the Day 8 Docker Compose
# network.
METRICS_SERVICE_URL=http://localhost:8081

# Downstream LLM or RAG endpoint the gateway proxies to
DOWNSTREAM_URL=http://localhost:11434

# Downstream RAG model routing (Ollama tag or vLLM model name; not a Gemini model)
DOWNSTREAM_MODEL=llama3.1:8b

# Postgres URL for the dev database (used by ingestion scripts and the gateway at runtime).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsentry

# Postgres URL for the test database (used by pytest only). This database is truncated
# and reingested during test runs. Create it with: createdb finsentry_test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsentry_test

# SEC EDGAR identity header — required, EDGAR rejects requests without it
# Format: "AppName email@example.com"
EDGAR_IDENTITY=fin-sentry noreply@fin-sentry.local

# Hugging Face Token
HF_TOKEN = your access token

# Gemini Faithfulness rail: choose backend
GEMINI_MODE=vertex  # options: vertex | developer | disabled

# Vertex AI mode (recommended, uses Google Cloud ADC auth + $300 credit)
GOOGLE_CLOUD_PROJECT=fin-sentry
GOOGLE_CLOUD_LOCATION=global

# Developer API mode (fallback, requires AI Studio API key)
# GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.6-flash

# Kafka event emission for async evaluation pipeline
# Note: Redpanda uses dual listeners. Host-side processes (gateway, consumer,
# dashboard) connect via the EXTERNAL listener at localhost:19092.
# In-Docker services (RisingWave sources) use the INTERNAL listener at
# redpanda:9092 (configured in infra/risingwave/init.sql).
KAFKA_MODE=disabled  # options: kafka | disabled
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CONSUMER_GROUP=finsentry-rag-flash-judge

# OpenTelemetry exporter (none = spans created but not exported)
OTEL_EXPORTER=none  # options: none | console | otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Local-debugging only: logs a raw downstream-model-output snippet on a
# schema-rail block. Leave unset (OFF) in the demo configuration -- a
# reliability/compliance platform must not log raw model output by default.
# DEV_DIAGNOSTIC_LOGS=1

# Red Team run password. Server-side only, never a NEXT_PUBLIC_ variable. The gateway
# refuses every Red Team run when this is empty or unset. Choose your own value.
RED_TEAM_RUN_PASSWORD=
